.idea/
**/android/.gradle/
**/android/local.properties
**/android/app/debug/
**/android/app/profile/
**/android/app/release/
*.aab
*.apk

# Signing keys and their passwords: never in Git (see release/README.md)
*.jks
*.keystore
key.properties
*.pem

